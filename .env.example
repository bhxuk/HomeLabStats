# HomeLabStats settings for Docker Compose.
# Copy to .env (cp .env.example .env), edit, then: docker compose up -d
# .env is not tracked by git, so in-app updates never overwrite your settings.
#
# Container controls, the speed test schedule, alert channels and how long to keep
# history are set in the app, on the Settings tab.

PORT=8090
DASH_USER=admin
# Set a password. Leave empty to disable login (not recommended).
DASH_PASSWORD=change-me

# Hosts pinged on the Network tab. Add your router, NAS or Tailscale peers by IP or name.
PING_TARGETS=1.1.1.1,8.8.8.8,google.com
DNS_NAMES=google.com,cloudflare.com,github.com
HTTP_CHECKS=https://www.google.com/generate_204,https://github.com

# Updates: check GitHub every N hours, and optionally install new versions automatically.
UPDATE_CHECK_HOURS=6
AUTO_UPDATE=false

# Only show these mount points on the Storage tab (comma separated). Empty = auto-detect.
DISK_PATHS=

TZ=Europe/London
